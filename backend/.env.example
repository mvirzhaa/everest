# Salin menjadi .env lalu isi. Semua nilai bisa juga diberikan sebagai environment variable.
PORT=8080
# URL publik backend Everest (bila memakai subpath, sertakan tanpa garis miring di akhir)
PUBLIC_URL=https://sc.uika-bogor.ac.id/everest
DATABASE_URL=postgres://everest:GANTI_PASSWORD@db:5432/everest

# Rahasia sesi (acak, panjang). Contoh: openssl rand -base64 48
JWT_SECRET=
# Kunci AES-256 untuk refresh token Google (64 karakter hex). Contoh: openssl rand -hex 32
ENC_KEY=

# SSO E-Portal UIKA (OpenID Connect)
OIDC_ISSUER=https://eportal.uika-bogor.ac.id
# Client ID yang boleh dipakai id_token (Android, web), dipisah koma
OIDC_AUDIENCES=everest-android,everest-web
OIDC_WEB_CLIENT_ID=everest-web
OIDC_WEB_CLIENT_SECRET=
# Email yang otomatis menjadi admin (dipisah koma)
ADMIN_EMAILS=

# Hanya untuk uji coba! Jangan aktifkan di produksi.
DEV_LOGIN=false

# Firebase Cloud Messaging: path file service account JSON
FCM_SERVICE_ACCOUNT=/run/secrets/fcm.json

# Google Calendar (OAuth client tipe "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Farhan cloud: anthropic | gemini (kosongkan untuk mematikan)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Kosong = claude-haiku-5-5 untuk anthropic; wajib diisi untuk gemini
LLM_MODEL=
FARHAN_DAILY_QUOTA=50

# Masa simpan titik lokasi Track biasa (hari). Data panic tidak dihapus otomatis.
TRACK_RETENTION_DAYS=30
UPLOAD_DIR=/data/uploads
MODELS_DIR=/data/models

# Eskalasi panic yang belum ditanggapi (detik sejak diterima server)
# Tahap 1: ke SEMUA satpam (termasuk yang tidak bertugas). Tahap 2: ke semua admin.
ESCALATE_GUARDS_SEC=120
ESCALATE_ADMINS_SEC=300
# Nomor pos satpam yang disarankan ke pengirim saat panic dieskalasi (opsional)
SECURITY_PHONE=

# Versi kebijakan privasi (halaman /privasi). Ubah setiap kali isinya berubah;
# samakan dengan Privacy.VERSION di aplikasi Android agar pengguna diminta setuju ulang.
PRIVACY_VERSION=2026-11-07
